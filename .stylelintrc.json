{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": [
      "^(bb5e[a-z0-9-]*(__[a-z0-9-]+)?(--[a-z0-9-]+)?|theme-(light|dark)|themed)$",
      {
        "message": "Classes must be in the bb5e namespace (BEM-style) or known Foundry theme classes"
      }
    ],
    "custom-property-pattern": ["^(bb5e-[a-z0-9-]+|z-index-[a-z]+|ui-scale)$"],
    "no-descending-specificity": null,
    "declaration-no-important": true
  }
}
