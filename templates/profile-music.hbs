<section class="tab {{tabs.music.cssClass}}" data-tab="music" data-group="sheet">
  <div class="bb5e-card" data-kind-group="boss" {{#if isElite}}hidden{{/if}}>
    <p class="hint">{{localize "BB5E.Music.Hint"}}</p>
    <div class="form-group">
      <label for="{{partId}}-music">{{localize "BB5E.Music.Source"}}</label>
      <div class="form-fields bb5e-music-pick">
        <input type="search" data-music-search placeholder="{{localize "BB5E.Music.Search"}}" aria-label="{{localize "BB5E.Music.Search"}}">
        <ul class="bb5e-music-hits" data-music-hits hidden></ul>
        <select id="{{partId}}-music" name="music">
          <option value="">{{localize "BB5E.Music.None"}}</option>
          {{#each music.groups}}
          <optgroup label="{{name}}">
            {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </optgroup>
          {{/each}}
        </select>
      </div>
      <p class="hint">{{localize "BB5E.Music.SourceHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-musicPriority">{{localize "BB5E.Music.Priority"}}</label>
      <div class="form-fields">
        <input type="number" id="{{partId}}-musicPriority" name="musicPriority" value="{{values.musicPriority}}" min="0" max="100" step="1">
      </div>
      <p class="hint">{{localize "BB5E.Music.PriorityHint"}}</p>
      <p class="bb5e-field-error" data-error-for="musicPriority" role="alert" hidden></p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-musicFade">{{localize "BB5E.Music.Fade"}}</label>
      <div class="form-fields">
        <input type="number" id="{{partId}}-musicFade" name="musicFade" value="{{musicFadeSeconds}}" min="0" max="10" step="0.5">
      </div>
      <p class="hint">{{localize "BB5E.Music.FadeHint"}}</p>
      <p class="bb5e-field-error" data-error-for="musicFade" role="alert" hidden></p>
    </div>
  </div>
  <div class="bb5e-card" data-kind-group="elite" {{#unless isElite}}hidden{{/unless}}>
    <p class="hint">{{localize "BB5E.Music.EliteHint"}}</p>
  </div>
</section>
