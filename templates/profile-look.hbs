<section class="tab {{tabs.look.cssClass}}" data-tab="look" data-group="sheet">
  <div data-kind-group="boss" {{#if isElite}}hidden{{/if}}>
    <div class="bb5e-look-pinned">
      <div class="bb5e-preview bb5e-look-preview"></div>
      <div class="bb5e-library__play" role="group" aria-label="{{localize "BB5E.Preview.Play"}}">
        {{#each look.steps}}<button type="button" data-action="lookPlay" data-step="{{step}}">{{label}}</button>{{/each}}
        <button type="button" data-action="lookPlay" data-step="quote">{{localize "BB5E.Workshop.Quote"}}</button>
      </div>
    </div>
    <div class="bb5e-card">
      <h3 class="bb5e-panel__heading">{{localize "BB5E.Workshop.Look"}}</h3>
      <div class="bb5e-workshop__looks">
        {{#each look.looks}}
        <button type="button" data-action="pickLook" data-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{name}}{{#unless builtIn}} <span class="bb5e-library__badge">{{localize "BB5E.Library.OwnBadge"}}</span>{{/unless}}</button>
        {{/each}}
      </div>
    </div>
    <div class="bb5e-card">
      <h3 class="bb5e-panel__heading">{{localize "BB5E.Workshop.Overrides"}}</h3>
      {{#each look.rows}}
      <div class="form-group">
        <label for="{{../partId}}-{{category}}">{{label}}</label>
        <div class="form-fields">
          <select id="{{../partId}}-{{category}}" name="overrides.{{category}}">
            <option value="">{{inLook}}</option>
            {{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </div>
      </div>
      {{/each}}
      <div class="bb5e-library__actions">
        <button type="button" data-action="copyLook"><i class="fa-solid fa-copy" inert></i> {{localize "BB5E.Workshop.CopyLook"}}</button>
      </div>
      <p class="hint">{{localize "BB5E.Profile.LookHint"}}</p>
    </div>
  </div>
  <div class="bb5e-card" data-kind-group="elite" {{#unless isElite}}hidden{{/unless}}>
    <p class="hint">{{localize "BB5E.Profile.EliteLook"}}</p>
  </div>
</section>
