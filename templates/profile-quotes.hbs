<section class="tab {{tabs.quotes.cssClass}}" data-tab="quotes" data-group="sheet">
  <div class="bb5e-card" data-kind-group="boss" {{#if isElite}}hidden{{/if}}>
    <p class="hint">{{localize "BB5E.Quotes.Hint"}}</p>
    <datalist id="{{partId}}-statuses">
      {{#each statusChoices}}<option value="{{id}}">{{name}}</option>{{/each}}
    </datalist>
    <ol class="bb5e-rows">
      {{#each quotes}}
      <li class="bb5e-rows__row" data-quote-index="{{index}}">
        <details class="bb5e-quote" name="{{@root.partId}}-quotes" data-quote-id="{{id}}" {{#if open}}open{{/if}}>
        <summary class="bb5e-quote__summary" data-quote-summary>{{summary}}</summary>
        <input type="hidden" name="quotes.{{index}}.id" value="{{id}}">
        <input type="hidden" name="quotes.{{index}}.newer" value="{{newer}}">
        <div class="bb5e-rows__line">
          <select name="quotes.{{index}}.trigger" aria-label="{{localize "BB5E.Quotes.Trigger.Label"}}">
            {{#each triggers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
          </select>
          <span data-quote-group="phase">
            <select name="quotes.{{index}}.phaseId" aria-label="{{localize "BB5E.Quotes.Phase"}}">
              <option value="">{{localize "BB5E.Quotes.ChoosePhase"}}</option>
              {{#each phases}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select>
          </span>
          <label data-quote-group="percent">
            <input type="number" name="quotes.{{index}}.percent" value="{{percent}}" min="1" max="99" step="1" aria-label="{{localize "BB5E.Quotes.Percent"}}"> %
          </label>
          <span data-quote-group="status">
            <input type="text" name="quotes.{{index}}.status" value="{{status}}" list="{{@root.partId}}-statuses" maxlength="80" placeholder="{{localize "BB5E.Quotes.Status"}}" aria-label="{{localize "BB5E.Quotes.Status"}}">
          </span>
        </div>
        <textarea name="quotes.{{index}}.texts" rows="2" placeholder="{{localize "BB5E.Quotes.Texts"}}" aria-label="{{localize "BB5E.Quotes.Texts"}}">{{texts}}</textarea>
        <div class="bb5e-rows__line">
          <select name="quotes.{{index}}.order" aria-label="{{localize "BB5E.Quotes.Order.Label"}}">
            <option value="random" {{#unless cycle}}selected{{/unless}}>{{localize "BB5E.Quotes.Order.Random"}}</option>
            <option value="cycle" {{#if cycle}}selected{{/if}}>{{localize "BB5E.Quotes.Order.Cycle"}}</option>
          </select>
          <label>{{localize "BB5E.Quotes.Cooldown"}}
            <input type="number" name="quotes.{{index}}.cooldown" value="{{cooldown}}" min="0" max="99" step="1">
          </label>
          <label>{{localize "BB5E.Quotes.Duration"}}
            <input type="number" name="quotes.{{index}}.duration" value="{{duration}}" min="1" max="20" step="0.5" placeholder="{{localize "BB5E.Quotes.Auto"}}">
          </label>
          <label><input type="checkbox" name="quotes.{{index}}.once" {{#if once}}checked{{/if}}> {{localize "BB5E.Quotes.Once"}}</label>
        </div>
        <div class="bb5e-rows__line bb5e-phase__buttons">
          <button type="button" data-action="playQuote" data-index="{{index}}"><i class="fa-solid fa-play" inert></i> {{localize "BB5E.Phases.Play"}}</button>
          <button type="button" data-action="moveQuote" data-index="{{index}}" data-delta="-1" aria-label="{{localize "BB5E.Phases.Up"}}" {{#if first}}disabled{{/if}}><i class="fa-solid fa-arrow-up" inert></i></button>
          <button type="button" data-action="moveQuote" data-index="{{index}}" data-delta="1" aria-label="{{localize "BB5E.Phases.Down"}}" {{#if last}}disabled{{/if}}><i class="fa-solid fa-arrow-down" inert></i></button>
          <button type="button" class="bb5e-rows__remove" data-action="removeQuote" data-index="{{index}}" aria-label="{{localize "BB5E.Quotes.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </div>
        <p class="bb5e-field-error" data-error-for="quotes.{{index}}.texts" role="alert" hidden></p>
        <p class="bb5e-field-error" data-error-for="quotes.{{index}}.percent" role="alert" hidden></p>
        <p class="bb5e-field-error" data-error-for="quotes.{{index}}.phaseId" role="alert" hidden></p>
        <p class="bb5e-field-error" data-error-for="quotes.{{index}}.status" role="alert" hidden></p>
        <p class="bb5e-field-error" data-error-for="quotes.{{index}}.cooldown" role="alert" hidden></p>
        <p class="bb5e-field-error" data-error-for="quotes.{{index}}.duration" role="alert" hidden></p>
        </details>
      </li>
      {{/each}}
    </ol>
    <div class="bb5e-rows__line">
      <button type="button" data-action="addQuote" {{#if quotesFull}}disabled{{/if}}><i class="fa-solid fa-plus" inert></i> {{localize "BB5E.Quotes.Add"}}</button>
      <span class="hint">{{localize "BB5E.Quotes.Limits"}}</span>
    </div>
    <div class="bb5e-preview bb5e-workshop__preview bb5e-quote-preview" aria-label="{{localize "BB5E.Profile.Preview"}}"></div>
  </div>
  <div class="bb5e-card" data-kind-group="elite" {{#unless isElite}}hidden{{/unless}}>
    <p class="hint">{{localize "BB5E.Quotes.EliteHint"}}</p>
  </div>
</section>
