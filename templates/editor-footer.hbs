<footer class="form-footer bb5e-footer">
  <span class="bb5e-footer__dirty" hidden>{{localize "BB5E.Unsaved.Badge"}}</span>
  {{#if hasProfile}}
    <button type="button" class="bb5e-footer__remove" data-action="removeProfile">
      <i class="fa-solid fa-trash" inert></i>
      {{localize "BB5E.Profile.Remove.Button"}}
    </button>
  {{/if}}
  <button type="submit">
    <i class="fa-solid fa-floppy-disk" inert></i>
    {{localize "BB5E.Profile.Save"}}
  </button>
</footer>